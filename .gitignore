node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Mídia pesada de cada vídeo fica fora do git (mantém só a estrutura)
public/videos/*/footage/*
public/videos/*/references/*
!public/videos/*/footage/.gitkeep
!public/videos/*/references/.gitkeep
!public/videos/*/references/links.txt

# Vídeo ativo é estado local de cada máquina
.active-video
